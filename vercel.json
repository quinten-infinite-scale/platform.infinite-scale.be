{
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/invoice-reminder", "schedule": "0 9 * * *" },
    { "path": "/api/whatsapp", "schedule": "0 8 * * *" },
    { "path": "/api/invoice-reminder?action=auto-invoice", "schedule": "0 2 1 * *" },
    { "path": "/api/sync-dials", "schedule": "0 6 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 7 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 8 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 9 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 10 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 11 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 12 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 13 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 14 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 15 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 16 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 17 * * *" },
    { "path": "/api/sync-dials", "schedule": "0 18 * * *" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sign/:token*", "destination": "/sign.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sign.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/reset-password.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
