{
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/invoice-reminder", "schedule": "0 9 * * *" },
    { "path": "/api/whatsapp", "schedule": "0 8 * * *" },
    { "path": "/api/invoice-reminder?action=auto-invoice", "schedule": "0 2 1 * *" },
    { "path": "/api/sync-dials", "schedule": "0 6-18 * * *" },
    { "path": "/api/sync-dials", "schedule": "30 6-18 * * *" },
    { "path": "/api/renocheck?action=status", "schedule": "0 19 * * *" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sign/:token*", "destination": "/sign.html" },
    { "source": "/api/save-contract", "destination": "/api/enhance-contract?route=save" },
    { "source": "/api/meta-callback", "destination": "/api/meta?action=callback" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sign.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/reset-password.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
